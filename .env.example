# Python development environment for Data Engineer Knowledge RAG
# Copy to .env and configure for your environment

# Azure Storage (Local Development with Azurite)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLMsff41PycQEvVxyD9xNNQ==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Vector Database
VECTOR_DB_TYPE=pinecone  # Options: pinecone, weaviate, milvus, others
VECTOR_DB_ENDPOINT=http://localhost:6333
VECTOR_DB_API_KEY=

# LangChain
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=de-agent-rag

# LLM Configuration (for embeddings and processing)
OPENAI_API_KEY=
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# RAG Pipeline
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
MAX_DOCUMENTS=1000
BATCH_SIZE=32

# MCP Server
MCP_PORT=8000
MCP_HOST=0.0.0.0
MCP_DEBUG=false
MCP_LOG_LEVEL=INFO

# Development
DEBUG=false
ENVIRONMENT=development  # Options: development, staging, production
